---
import BaseLayout from "../layouts/BaseLayout.astro";

const focuses = [
  {
    number: "01",
    title: "AI 编码的工程边界",
    description: "关注如何让 Agent 参与开发后，目标、决策、验证与恢复依然有据可查。",
  },
  {
    number: "02",
    title: "可靠的工程实践",
    description: "持续学习 Java、Python 与分布式系统相关的工程方法，并把经验落在可复查的作品中。",
  },
  {
    number: "03",
    title: "技术以外的长期观察",
    description: "市场、历史与社会变化会不定期出现；它们帮助我从更大的尺度理解技术。",
  },
];
---

<BaseLayout title="Now" description="Tang Hui 当前在关注什么。">
  <section class="page-intro now-intro">
    <p class="eyebrow">Now / 2026</p>
    <h1>此刻，<br />我在关注什么？</h1>
    <p>这不是履历，也不是待办清单。它是一个会不时更新的坐标：让我和首次来到这里的人，都能知道我正往哪里走。</p>
  </section>
  <section class="now-list" aria-label="当前关注主题">
    {focuses.map((focus) => (
      <article>
        <span>{focus.number}</span>
        <div>
          <h2>{focus.title}</h2>
          <p>{focus.description}</p>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
