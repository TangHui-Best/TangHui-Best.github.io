---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    number: "01",
    title: "AgentMentor",
    label: "AI-assisted engineering memory",
    description: "面向 Codex、Claude Code 等编码 Agent 的工程记忆框架。它将功能目标、设计取舍、已验证事实与可复用经验保留在代码库中，降低长期迭代中“只看到代码、看不到为什么”的信息损失。",
    stack: ["AI Agent", "Skills", "Engineering workflow"],
    href: "https://github.com/TangHui-Best/ai-coding-harness",
  },
];
---

<BaseLayout title="项目" description="可验证的项目与工程实践。">
  <a class="back-link page-back" href="/">← 首页</a>
  <section class="page-intro page-intro--from-home">
    <p class="eyebrow">Selected work</p>
    <h1>一些实践与思考。</h1>
    <p>这里是我做过的项目：它们解决的问题、运行的方式，以及留下的思考。</p>
  </section>
  <section class="projects" aria-label="项目列表">
    {projects.map((project) => (
      <article class="project-row">
        <span class="project-number">{project.number}</span>
        <div>
          <p class="eyebrow">{project.label}</p>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <div class="tag-list" aria-label="项目主题">
            {project.stack.map((item) => <span>{item}</span>)}
          </div>
          <a class="project-link" href={project.href} target="_blank" rel="noreferrer">在 GitHub 查看项目 <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    ))}
  </section>
  <p class="project-note">更多项目会在具备公开条件与可验证内容后陆续加入。</p>
</BaseLayout>
