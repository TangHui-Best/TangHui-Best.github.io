---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
---

<BaseLayout title="项目" description="可公开、可验证的项目与工程实践。">
  <div class="shell">
    <section class="page-head">
      <a class="back-link" href="/">← 首页</a>
      <div class="page-head__row">
        <div>
          <p class="kicker">Selected work</p>
          <h1 class="sec-title">项目</h1>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <div>
          <p class="lede">能公开的和值得公开的，不是一回事。这里只放前一种：解决的问题、运行的方式，以及留下来的思考。</p>
        </div>
      </div>
    </section>

    <section class="section-pad" aria-label="项目列表">
      <FeaturedProject showAllLink={false} />
      <p class="note-line">更多项目会在具备公开条件与可验证内容后陆续加入。</p>
    </section>
  </div>
</BaseLayout>
