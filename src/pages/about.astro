---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
import headshot from "../assets/tang-hui-headshot.jpg";

const systems = [
  {
    number: "01",
    title: "RPA Agent",
    statement: "让自动化能力进入真实业务流程。",
    context: "业务流程中的规则、上下文与人工判断，并不天然适配自动化。",
    role: "参与 Agent 与 RPA 自动化能力的工程实践，关注任务理解、流程编排与异常处理如何落入真实场景。",
    constraint: "自动化不仅要跑通，还要能在既有系统、权限边界与长期维护中持续成立。",
  },
  {
    number: "02",
    title: "Agent Gateway",
    statement: "为复杂 Agent 生态建立连接层。",
    context: "Agent、工具与企业服务增多后，接入、调用与责任边界很容易快速分散。",
    role: "参与多 Agent、多系统接入的工程实践，关注服务治理、可观测性与长期可维护性。",
    constraint: "权限、协议、稳定性与演进成本需要被前置设计，而不是在系统复杂后补救。",
  },
];
---

<BaseLayout title="About Me" description="Tang Hui 的企业级 AI / Agent 工程实践与个人介绍。" wide>
  <section class="about-case-hero" aria-labelledby="about-title">
    <div class="about-case-hero__copy">
      <div class="about-case-hero__topline">
        <span>Build agents for a more capable organization</span>
        <a class="back-link" href="/">← 首页</a>
      </div>
      <div class="about-case-hero__identity">
        <p class="about-index">01</p>
        <h1 id="about-title">Tang <span>Hui</span></h1>
        <p class="about-case-hero__role">企业级 AI / Agent 工程师</p>
        <p class="about-case-hero__date">2022.07 — 至今</p>
      </div>
      <div class="about-case-hero__statement">
        <p>近四年，我在华为参与 Agent、自动化与数字化平台的工程实践。</p>
        <p>我的工作，是把模型能力放进复杂组织的既有系统里，并把接入、编排、治理和可靠运行一起做成可持续演进的工程能力。</p>
      </div>
    </div>
    <figure class="about-portrait">
      <div class="about-portrait__frame">
        <div class="about-portrait__photo">
          <img src={headshot.src} width={headshot.width} height={headshot.height} alt="Tang Hui 的职业照" fetchpriority="high" />
        </div>
        <div class="about-portrait__rail" aria-hidden="true">
          <span>Tang Hui</span>
          <span>People<br />Processes<br />Agents<br />Real outcomes</span>
          <span>Engineer for a more capable tomorrow</span>
        </div>
      </div>
      <figcaption>
        <span>Tang Hui</span>
        <span>Enterprise AI /<br />Agent Engineer</span>
        <span>2022 — Now</span>
      </figcaption>
    </figure>
  </section>

  <section class="case-studies" aria-labelledby="case-studies-title">
    <div class="case-studies__heading">
      <div>
        <p class="about-index">02</p>
        <h2 id="case-studies-title">参与过的系统与问题</h2>
      </div>
      <p>From complexity to capability</p>
    </div>
    <div class="case-studies__list">
      {systems.map((system) => (
        <article class="system-case">
          <div class="system-case__title">
            <span>{system.number}</span>
            <div>
              <h3>{system.title}</h3>
              <p>{system.statement}</p>
            </div>
          </div>
          <div class="system-case__evidence">
            <div>
              <span>场景</span>
              <p>{system.context}</p>
            </div>
            <div>
              <span>参与</span>
              <p>{system.role}</p>
            </div>
            <div>
              <span>工程约束</span>
              <p>{system.constraint}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="case-studies__note">公开范围：仅讨论工程问题与个人职责，不涉及内部数据或实现细节。</p>
  </section>

  <section class="public-practice" aria-labelledby="public-practice-title">
    <div>
      <p class="eyebrow">03 · Public practice</p>
      <h2 id="public-practice-title">把工程判断，<br />留在可查看的作品里。</h2>
    </div>
    <div class="public-practice__body">
      <p>公开侧，我持续维护 <strong>ai-coding-harness</strong>，把对 Agent 开发流程、验证与可恢复性的思考沉淀为可阅读、可追溯的内容。</p>
      <div class="public-practice__actions">
        <a class="button" href="/projects">查看公开项目</a>
        <a class="tab-link" href="/writing">阅读技术写作 →</a>
      </div>
    </div>
  </section>

  <section class="about-beyond about-beyond--quiet" aria-labelledby="beyond-title">
    <div>
      <p class="eyebrow">04 · Beyond work</p>
      <h2 id="beyond-title">工程之外，<br />也保持好奇。</h2>
    </div>
    <p>市场、历史与旅行会不定期出现。它们提醒我：技术从来不是孤立发生的，也帮助我在工作之外保持对人与系统的长期观察。</p>
  </section>

  <section class="about-contact" aria-labelledby="contact-title">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">如果这些问题也在你的工作里发生，欢迎交流。</h2>
    <div>
      {site.github && <a class="text-link" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>}
      {site.email && <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>}
      {!site.github && !site.email && <p>公开联系方式将在确认后展示。</p>}
    </div>
  </section>
</BaseLayout>
