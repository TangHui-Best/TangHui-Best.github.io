---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
---

<BaseLayout title="关于" description="Tang Hui 的个人网站。">
  <section class="page-intro about-intro">
    <p class="eyebrow">About</p>
    <h1>关于这个站点</h1>
    <p>这是 Tang Hui 的长期个人网站。技术是目前最主要的表达方式，市场、历史与其他长期兴趣会在合适的时候出现。</p>
  </section>
  <section class="about-grid">
    <div>
      <p class="eyebrow">写作原则</p>
      <p>尽量从真实问题出发，说明判断依据，保留结果与局限。数量不是目标，清晰和可验证才是。</p>
    </div>
    <div>
      <p class="eyebrow">联系</p>
      {site.github && <p><a class="text-link" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a></p>}
      {site.email && <p><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></p>}
      {!site.github && !site.email && <p>在 <code>src/config.ts</code> 填入 GitHub 链接与邮箱后，这里会自动显示。</p>}
    </div>
  </section>
</BaseLayout>
