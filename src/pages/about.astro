---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
import headshot from "../assets/tang-hui-headshot.jpg";

const systems = [
  {
    title: "RPA Agent",
    statement: "让自动化能力进入真实业务流程。",
    context: "业务流程中的规则、上下文与人工判断，并不天然适配自动化。",
    role: "参与 Agent 与 RPA 自动化能力的工程实践，关注任务理解、流程编排与异常处理如何落入真实场景。",
    constraint: "自动化不仅要跑通，还要能在既有系统、权限边界与长期维护中持续成立。",
  },
  {
    title: "Agent Gateway",
    statement: "为复杂 Agent 生态建立连接层。",
    context: "Agent、工具与企业服务增多后，接入、调用与责任边界很容易快速分散。",
    role: "参与多 Agent、多系统接入的工程实践，关注服务治理、可观测性与长期可维护性。",
    constraint: "权限、协议、稳定性与演进成本需要被前置设计，而不是在系统复杂后补救。",
  },
];

const facts = [
  { label: "所在", value: "华为 · 深圳" },
  { label: "方向", value: "企业级 AI / Agent" },
];
---

<BaseLayout title="关于" description="Tang Hui 的企业级 AI / Agent 工程实践与个人介绍。">
  <div class="shell">
    <section class="about-hero" aria-labelledby="about-title">
      <a class="back-link" href="/">← 首页</a>
      <div class="about-hero__grid">
        <div class="about-hero__copy">
          <p class="kicker">About</p>
          <h1 id="about-title" class="about-name">Tang <span>Hui</span></h1>
          <p class="about-role">{site.role}</p>
          <p class="about-period">2022.07 — 至今</p>
          <p class="about-statement">
            我的工作，是把模型能力带入复杂组织的既有系统，并把接入、编排、治理和可靠运行组织为可持续演进的工程能力。
          </p>
        </div>

        <div class="about-hero__side">
          <figure class="profile">
            <div class="profile__head" aria-hidden="true">
              <span>Work profile</span>
              <span>01</span>
            </div>
            <div class="profile__body">
              <div class="profile__photo">
                <span class="profile__photo-frame" aria-hidden="true"></span>
                <div class="profile__photo-inner">
                  <img
                    src={headshot.src}
                    width={headshot.width}
                    height={headshot.height}
                    alt={`${site.title} 的职业照`}
                    fetchpriority="high"
                  />
                </div>
              </div>
              <dl class="facts">
                {facts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <figcaption class="profile__foot">
              <span>2022.07 — now</span>
              <span>持续工程实践</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="sec" aria-labelledby="cases-title">
      <div class="twelve" style="margin-bottom:1.6rem">
        <div class="col-4">
          <p class="kicker">Problems</p>
          <h2 id="cases-title" class="sec-title">我在解决的问题</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <div class="col-8 col-8--end">
          <p class="copy" style="margin-top:0">公开范围：仅讨论工程问题与个人职责，不涉及内部数据或实现细节。</p>
        </div>
      </div>

      <div class="cases">
        {systems.map((system, i) => (
          <article class="case">
            <div class="case__head">
              <span class="case__no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="case__title">{system.title}</h3>
                <p class="case__statement">{system.statement}</p>
              </div>
            </div>
            <div class="case__evidence">
              <div>
                <span class="case__label">场景</span>
                <p>{system.context}</p>
              </div>
              <div>
                <span class="case__label">参与</span>
                <p>{system.role}</p>
              </div>
              <div>
                <span class="case__label">工程约束</span>
                <p>{system.constraint}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <section class="sec sec--surface" aria-labelledby="public-title">
    <div class="shell">
      <div class="twelve">
        <div class="col-4">
          <p class="kicker">Public work</p>
          <h2 id="public-title" class="sec-title">公开实践</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <div class="col-8">
          <p class="lead">把工程判断，留在可查看的作品里。</p>
          <p class="copy">
            公开侧，我持续维护 <strong>ai-coding-harness</strong>，把对 Agent 开发流程、验证与可恢复性的思考沉淀为可阅读、可追溯的内容。
          </p>
          <div class="cta">
            <a class="btn btn--solid" href="/projects">查看公开项目 <span aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href="/writing">阅读技术写作 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="beyond-title">
    <div class="shell">
      <div class="twelve">
        <div class="col-4">
          <p class="kicker">Beyond</p>
          <h2 id="beyond-title" class="sec-title">工作之外</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <div class="col-8">
          <p class="lead">工程之外，也保持好奇。</p>
          <p class="copy">
            市场、历史与旅行提醒我：技术从不孤立发生，也需要放在对人与系统的长期观察里理解。
          </p>
          {site.github && (
            <a class="text-link" href={site.github} target="_blank" rel="noreferrer noopener">
              GitHub <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
