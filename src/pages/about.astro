---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";

const capabilities = [
  {
    number: "01",
    title: "Agent 与自动化工程化",
    description: "让 Agent、RPA 与工作流进入真实业务场景，关注可编排能力、运行边界与持续运营，而不止是一次演示。",
  },
  {
    number: "02",
    title: "平台集成与服务治理",
    description: "围绕 Agent Gateway、A2A、MCP 和跨系统协作，处理接入、权限、协议与可观测性等工程问题。",
  },
  {
    number: "03",
    title: "分布式系统的可靠交付",
    description: "以 Java、Python 和分布式高并发实践为底座，持续关注系统的稳定性、可追溯性与可恢复性。",
  },
];

const platforms = [
  {
    number: "01",
    title: "RPA Agent",
    description: "参与 Agent 与 RPA 自动化能力的工程实践，探索怎样让能力更自然地进入业务流程。",
  },
  {
    number: "02",
    title: "Agent Gateway",
    description: "面向多 Agent 与多系统接入，关注连接方式、服务治理与长期可维护性。",
  },
  {
    number: "03",
    title: "LiveFlow",
    description: "参与数字化流程平台相关实践，在高并发和跨系统协同的约束下推进能力落地。",
  },
];

const focuses = [
  {
    number: "01",
    title: "AI 编码的工程边界",
    description: "当 Agent 参与开发，目标、决策、验证与恢复仍然要有据可查。工具可以更快，但工程不能失去边界。",
  },
  {
    number: "02",
    title: "可靠性不是收尾工作",
    description: "真正进入业务的 AI 系统，需要从接入、权限、运行到故障恢复都被认真设计，而不是上线前再补救。",
  },
  {
    number: "03",
    title: "技术以外的长期观察",
    description: "市场、历史与社会变化会不定期出现；它们帮助我从更大的尺度理解技术与人的选择。",
  },
];
---

<BaseLayout title="About Me" description="Tang Hui 的企业级 AI / Agent 工程实践与个人介绍。">
  <a class="back-link page-back" href="/">← 首页</a>
  <section class="page-intro page-intro--from-home about-intro">
    <p class="eyebrow">About Me</p>
    <h1>把复杂的事，<br />做成可落地的系统。</h1>
    <p>我是 Tang Hui，一名从事企业级 AI / Agent 工程实践的解决方案架构与开发工程师。近四年，我在华为参与 Agent、自动化与数字化平台相关工作。</p>
  </section>

  <section class="about-profile" aria-labelledby="profile-title">
    <div class="about-profile-copy">
      <p class="eyebrow">Profile</p>
      <h2 id="profile-title">不只是会用 AI，<br />也把它放进复杂系统里。</h2>
      <p>我关注的不是“模型能做什么”，而是它进入业务之后，如何与既有系统协同，如何被管理，也如何在不确定性中保持可靠。</p>
    </div>
    <ul class="profile-facts" aria-label="职业信息">
      <li><span>经验</span><strong>2022.07 — 至今 · 华为</strong></li>
      <li><span>所在地</span><strong>深圳 · 28 岁 · 硕士</strong></li>
      <li><span>方向</span><strong>AI 解决方案架构与软件开发</strong></li>
    </ul>
  </section>

  <section class="capability-section" aria-labelledby="capability-title">
    <div class="section-kicker">
      <p class="eyebrow">Capability</p>
      <h2 id="capability-title">我的工程坐标</h2>
    </div>
    <div class="capability-list" aria-label="工程能力">
      {capabilities.map((capability) => (
        <article>
          <span>{capability.number}</span>
          <div>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="platform-section" aria-labelledby="platform-title">
    <div class="section-kicker">
      <p class="eyebrow">Selected practice</p>
      <h2 id="platform-title">参与过的工程实践</h2>
      <p>以下是工作中参与的平台方向，用来说明问题场景，不披露内部数据、客户信息或实现细节。</p>
    </div>
    <div class="platform-list" aria-label="代表工程实践">
      {platforms.map((platform) => (
        <article>
          <span>{platform.number}</span>
          <h3>{platform.title}</h3>
          <p>{platform.description}</p>
        </article>
      ))}
    </div>
    <p class="public-work">公开侧，我也在持续维护 <a class="text-link" href="/projects">ai-coding-harness ↗</a>，把对 Agent 开发流程、验证与可恢复性的思考放进可查看的作品里。</p>
  </section>
  <section class="about-now" aria-labelledby="now-title">
    <div class="about-now-heading">
      <p class="eyebrow">Now</p>
      <h2 id="now-title">此刻，<br />我在关注什么？</h2>
      <p>这不是履历，也不是待办清单。它是一个会不时更新的坐标：让我和首次来到这里的人，都能知道我正往哪里走。</p>
    </div>
    <div class="now-list" aria-label="当前关注主题">
      {focuses.map((focus) => (
        <article>
          <span>{focus.number}</span>
          <div>
            <h3>{focus.title}</h3>
            <p>{focus.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="about-beyond" aria-labelledby="beyond-title">
    <div>
      <p class="eyebrow">Beyond work</p>
      <h2 id="beyond-title">工程之外，<br />也保持好奇。</h2>
    </div>
    <p>旅行让我重新感受尺度，市场和历史则提醒我：技术从来不是孤立发生的。这个网站也会慢慢收录那些在工作以外、却持续影响我判断的观察。</p>
  </section>

  <section class="about-contact" aria-labelledby="contact-title">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">如果这些问题也在你的工作里发生，欢迎交流。</h2>
    <div>
      {site.github && <a class="text-link" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a>}
      {site.email && <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>}
      {!site.github && !site.email && <p>公开联系方式将在确认后展示。</p>}
    </div>
  </section>
</BaseLayout>
