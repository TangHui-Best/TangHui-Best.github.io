---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostMeta from "../components/PostMeta.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero" aria-labelledby="intro-title">
    <p class="eyebrow">个人网站 · 持续建设中</p>
    <h1 id="intro-title">写下做过的事，<br />也写下让 AI 落地的过程。</h1>
    <p class="hero-copy">我目前在华为工作，关注 AI、Agent 与工程实践。这里收录可验证的项目、技术复盘，以及技术之外仍在生长的好奇心。</p>
    <div class="hero-actions" aria-label="探索网站">
      <a class="button" href="/writing">阅读文章</a>
      <a class="tab-link" href="/projects">查看项目 <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="latest-section" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Writing</p>
        <h2 id="latest-title">从真实问题开始</h2>
      </div>
      <a class="section-link" href="/writing">全部文章 <span aria-hidden="true">→</span></a>
    </div>
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => (
          <article class="post-row">
            <div>
              <PostMeta date={post.data.pubDate} tags={post.data.tags} />
              <h3><a href={`/writing/${post.slug}`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
            <a class="arrow-link" href={`/writing/${post.slug}`} aria-label={`阅读：${post.data.title}`}>↗</a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">第一篇文章正在打磨中。</p>
    )}
  </section>
</BaseLayout>
