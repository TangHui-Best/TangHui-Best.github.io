---
import { formatDate } from "../config";

interface Props {
  date: Date;
  tags?: string[];
}

const { date, tags = [] } = Astro.props;
---

<div class="meta">
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
  {tags.length > 0 && <span class="meta__sep" aria-hidden="true">/</span>}
  {tags.map((tag, i) => (
    <>
      {i > 0 && <span class="meta__sep" aria-hidden="true">/</span>}
      <span>{tag}</span>
    </>
  ))}
</div>
